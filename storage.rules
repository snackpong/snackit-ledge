rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'snackpong25@gmail.com';
    }
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
